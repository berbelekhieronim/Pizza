{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pizza-study",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pizza-study",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "pizza-study-files"
    }
  ],
  "observability": {
    "enabled": false
  },
  "ratelimits": [
    {
      "name": "START_LIMIT",
      "namespace_id": "7101",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "SAVE_LIMIT",
      "namespace_id": "7102",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "ADMIN_LIMIT",
      "namespace_id": "7103",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "vars": {},
  "keep_vars": true
}
